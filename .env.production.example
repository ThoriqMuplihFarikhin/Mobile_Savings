APP_NAME="Tabungan Digital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tabungan.contoh.domain
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database produksi: WAJIB MySQL 8.0+ / MariaDB 10.2+ (SQLite dilarang karena tidak mendukung lockForUpdate)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tabungan_digital_prod
DB_USERNAME=tabungan_app_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true di produksi agar cookie hanya dikirim lewat HTTPS
SESSION_SECURE_COOKIE=true

# Batas idle admin sebelum otomatis keluar (menit)
ADMIN_IDLE_MINUTES=30

# IP proxy/load balancer tepercaya (pisahkan koma). Kosong bila Nginx langsung ke PHP-FPM di mesin yang sama.
# Isi IP reverse proxy/Cloudflare bila ada. Jangan gunakan "*" kecuali seluruh trafik melewati proxy pembersih header.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@contoh.domain"
MAIL_FROM_NAME="${APP_NAME}"

# Integrasi WhatsApp Gateway (fonnte / wablas / generic)
# WHATSAPP_API_URL wajib diisi di sini agar pengiriman PIN awal dan notifikasi nasabah berjalan
WHATSAPP_PROVIDER=fonnte
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=

# PIN admin awal saat database seeder dijalankan (6 digit angka; setelah login pertama wajib diganti)
SEED_ADMIN_PIN=

VITE_APP_NAME="${APP_NAME}"
